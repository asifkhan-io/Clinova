# Phase 0
DATABASE_URL=                 # Neon pooled — the app
DATABASE_URL_UNPOOLED=        # Neon direct — migrations only
APP_DATABASE_URL=             # Neon pooled, role clinova_app (Phase 9b) — the app uses this when set; it cannot edit or delete the audit log
DB_QUERY_TIMEOUT_MS=          # optional, local dev only: raise to 30000 if a sleeping Neon compute + slow link times out (default 10000)

# Phase 2 — auth
BETTER_AUTH_SECRET=           # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_URL=              # http://localhost:3000 in dev

# Phase 8d — email
RESEND_API_KEY=               # resend.com → API Keys. Unset = no email is sent, nothing fails
EMAIL_FROM=                   # "Clinova <onboarding@resend.dev>" until a domain is verified
CRON_SECRET=                  # any long random string; Vercel Cron sends it, the digest route checks it
