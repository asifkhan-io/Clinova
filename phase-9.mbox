diff --git a/server/db/retry.ts b/server/db/retry.ts
new file mode 100644
index 0000000..c84bcf7
--- /dev/null
+++ b/server/db/retry.ts
@@ -0,0 +1,25 @@
+/**
+ * Postgres can settle two transactions racing for one slot with a DEADLOCK
+ * (40P01) instead of the exclusion-constraint violation (23P01): each insert
+ * waits to see whether the other's conflicting row commits. Postgres aborts one
+ * of them, and its booking is safely gone, but without this the patient got a
+ * server error instead of "that time was just taken" (finding F4, Phase 9).
+ *
+ * Retrying the aborted transaction is the standard fix: by then the winner has
+ * committed, so the retry fails cleanly with 23P01 and the caller's normal
+ * "slot taken" path answers. Only deadlocks are retried, a few times at most.
+ */
+export function isDeadlock(error: unknown) {
+  const e = ((error as { cause?: unknown })?.cause ?? error) as { code?: string };
+  return e?.code === "40P01";
+}
+
+export async function retryOnDeadlock<T>(run: () => Promise<T>, attempts = 3): Promise<T> {
+  for (let attempt = 1; ; attempt++) {
+    try {
+      return await run();
+    } catch (error) {
+      if (!isDeadlock(error) || attempt >= attempts) throw error;
+    }
+  }
+}
diff --git a/tests/retry.test.ts b/tests/retry.test.ts
new file mode 100644
index 0000000..22ada05
--- /dev/null
+++ b/tests/retry.test.ts
@@ -0,0 +1,39 @@
+/**
+ * Finding F4: a deadlock between two racing bookings must be retried, so the
+ * loser hears "slot taken" instead of getting a server error.
+ */
+import { describe, expect, it } from "vitest";
+import { isDeadlock, retryOnDeadlock } from "@/server/db/retry";
+
+const deadlock = Object.assign(new Error("Failed query"), { cause: { code: "40P01" } });
+const overlap = Object.assign(new Error("Failed query"), { cause: { code: "23P01" } });
+
+describe("retryOnDeadlock", () => {
+  it("recognises a deadlock directly or wrapped by the driver", () => {
+    expect(isDeadlock(deadlock)).toBe(true);
+    expect(isDeadlock({ code: "40P01" })).toBe(true);
+    expect(isDeadlock(overlap)).toBe(false);
+  });
+
+  it("retries a deadlock, then hands the clean result back", async () => {
+    let calls = 0;
+    const result = await retryOnDeadlock(async () => {
+      if (++calls === 1) throw deadlock;
+      return "slot_taken";
+    });
+    expect(result).toBe("slot_taken");
+    expect(calls).toBe(2);
+  });
+
+  it("never retries other errors: they reach the caller's own handling at once", async () => {
+    let calls = 0;
+    await expect(retryOnDeadlock(async () => { calls++; throw overlap; })).rejects.toBe(overlap);
+    expect(calls).toBe(1);
+  });
+
+  it("gives up after three attempts", async () => {
+    let calls = 0;
+    await expect(retryOnDeadlock(async () => { calls++; throw deadlock; })).rejects.toBe(deadlock);
+    expect(calls).toBe(3);
+  });
+});
